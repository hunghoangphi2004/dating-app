<div class="card shadow-sm border-0 mb-4">
    <div class="card-body">

        <h6 class="mb-3 fw-bold">
            <i class="fa fa-filter me-2"></i>
            Lọc theo độ tuổi
        </h6>

        <div class="row g-2 align-items-end">

            <div class="col-md-4">
                <label class="form-label small text-muted">Từ</label>
                <input type="number"
                       class="form-control"
                       placeholder="Ví dụ: 18"
                       value="<%= filterAge.minAge || '' %>"
                       input-min-age>
            </div>

            <div class="col-md-4">
                <label class="form-label small text-muted">Đến</label>
                <input type="number"
                       class="form-control"
                       placeholder="Ví dụ: 30"
                       value="<%= filterAge.maxAge || '' %>"
                       input-max-age>
            </div>

            <div class="col-md-4">
                <button class="btn btn-primary w-100" button-age>
                    <i class="fa fa-search me-1"></i>
                    Lọc
                </button>
            </div>

        </div>

    </div>
</div>
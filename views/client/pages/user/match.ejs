<div class="container mt-4">

    <h4 class="mb-4">
        <i class="fa fa-heart text-danger me-2"></i>
        Danh sách Match
    </h4>

    <% if (users.length === 0) { %>

        <div class="text-center mt-5">
            <i class="fa fa-heart-broken fa-3x text-muted mb-3"></i>
            <p class="text-muted">Bạn chưa có match nào.</p>
            <a href="/user/list" class="btn btn-outline-primary btn-sm">
                Khám phá ngay
            </a>
        </div>

    <% } else { %>

        <div class="row">
            <% users.forEach(user => { %>
                <div class="col-lg-3 col-md-4 col-sm-6 mb-4">
                    <div class="card shadow-sm h-100 border-0">

                        <div style="height:220px; overflow:hidden;">
                            <img src="<%= user.avatar %>"
                                 class="w-100"
                                 style="height:100%; object-fit:cover;"
                                 alt="<%= user.name %>">
                        </div>

                        <div class="card-body">
                            <h5 class="card-title mb-1">
                                <%= user.name %>, <%= user.age %>
                            </h5>

                            <p class="text-muted mb-2">
                                <%= user.gender === "male" ? "Nam" : "Nữ" %>
                            </p>

                            <p class="card-text small">
                                <%= user.bio %>
                            </p>
                        </div>

                        <div class="card-footer bg-white border-0 pt-0 pb-3">
                            <div class="d-flex justify-content-between gap-2">

                                <a href="/user/<%= user._id %>"
                                   class="btn btn-outline-primary btn-sm w-50">
                                    Hồ sơ
                                </a>

                                <a href="/user/match/schedule/<%= user.matchId %>"
                                   class="btn btn-success btn-sm w-50">
                                    Chọn lịch
                                </a>

                            </div>
                        </div>

                    </div>
                </div>
            <% }) %>
        </div>

    <% } %>

</div>
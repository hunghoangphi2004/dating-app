<div class="container mt-4">

    <!-- Thông tin người match -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body d-flex align-items-center">

            <img src="<%= otherUser.avatar %>" class="rounded-circle me-3"
                style="width:80px; height:80px; object-fit:cover;" alt="<%= otherUser.name %>">

            <div>
                <h5 class="mb-1">
                    <%= otherUser.name %>, <%= otherUser.age %>
                </h5>
                <p class="text-muted mb-0">
                    <%= otherUser.gender==="male" ? "Nam" : "Nữ" %>
                </p>
            </div>

        </div>
    </div>


    <h4 class="mb-3">
        <i class="fa fa-calendar me-2"></i>
        Chọn thời gian rảnh
    </h4>


    <% if (match.status==="scheduled" ) { %>

        <div class="border rounded p-3 mb-4 bg-light">
            Hai bạn có date vào
            <strong>
                <%= match.formattedScheduledDate %>
            </strong>
            từ <strong>
                <%= match.scheduledStart %>
            </strong>
            đến <strong>
                <%= match.scheduledEnd %>
            </strong>
        </div>

        <% } else if (bothSelected) { %>

            <div class="border rounded p-3 mb-4 text-muted">
                Chưa tìm được thời gian trùng. Vui lòng chọn lại.
            </div>

            <% } %>


                <!-- Form thêm slot -->
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-body">
                        <form method="POST" action="/user/match/schedule/<%= match._id %>">
                            <div class="row align-items-end">

                                <div class="col-md-4 mb-3">
                                    <label class="form-label">Ngày</label>
                                    <input type="date" name="date" class="form-control"
                                        min="<%= new Date().toISOString().split('T')[0] %>" required>
                                </div>

                                <div class="col-md-3 mb-3">
                                    <label class="form-label">Từ giờ</label>
                                    <input type="time" name="start" class="form-control" required>
                                </div>

                                <div class="col-md-3 mb-3">
                                    <label class="form-label">Đến giờ</label>
                                    <input type="time" name="end" class="form-control" required>
                                </div>

                                <div class="col-md-2 mb-3">
                                    <button class="btn btn-primary w-100">
                                        <i class="fa fa-plus"></i> Thêm
                                    </button>
                                </div>

                            </div>
                        </form>
                    </div>
                </div>


                <!-- Slot của bạn -->
                <h5 class="mb-3">
                    <i class="fa fa-clock me-2"></i>
                    Slot của bạn
                </h5>

                <% if (mySlots.length===0) { %>
                    <div class="text-muted">
                        Bạn chưa thêm thời gian rảnh nào.
                    </div>
                    <% } else { %>
                        <div class="row">
                            <% mySlots.forEach(slot=> { %>
                                <div class="col-md-4 mb-3">
                                    <div class="card border-0 shadow-sm position-relative">
                                        <div class="card-body text-center">

                                            <!-- Nút X nhỏ góc phải -->
                                            <form method="POST"
                                                action="/user/match/schedule/<%= match._id %>/delete/<%= slot._id %>"
                                                class="position-absolute top-0 end-0 m-2">
                                                <button class="btn btn-sm btn-outline-danger px-2 py-1">
                                                    ✕
                                                </button>
                                            </form>

                                            <div class="fw-bold mb-2">
                                                📅 <%= slot.formattedDate %>
                                            </div>

                                            <div class="text-muted">
                                                ⏰ <%= slot.start %> - <%= slot.end %>
                                            </div>

                                        </div>
                                    </div>
                                </div>
                                <% }) %>
                        </div>
                        <% } %>

</div>